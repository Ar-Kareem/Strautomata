{
  "name": "arena-fe",
  "version": "0.0.0",
  "scripts": {
    "ng": "bash scripts/node-run.sh node_modules/@angular/cli/bin/ng.js",
    "generate:manifest": "bash scripts/node-run.sh scripts/generate_game_arena_manifest.cjs",
    "check:history": "bash scripts/node-run.sh scripts/check_history.cjs",
    "prestart": "bash scripts/node-run.sh scripts/check_history.cjs",
    "start": "bash scripts/node-run.sh scripts/watch_game_arena_manifest.cjs -- npm run ng -- serve --host 0.0.0.0 --port 4267",
    "prebuild": "bash scripts/node-run.sh scripts/check_history.cjs",
    "build": "npm run generate:manifest && npm run ng -- build",
    "watch": "npm run generate:manifest && npm run ng -- build --watch --configuration development",
    "test": "npm run ng -- test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@ngrx/store": "^21.0.1",
    "@primeuix/themes": "^2.0.3",
    "codemirror": "^6.0.2",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@ngrx/store": "^21.0.1",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
