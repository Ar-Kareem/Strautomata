{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "arena_fe": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*.py",
                "input": "../../game_arena",
                "output": "py/game_arena",
                "ignore": [
                  "**/examples/**",
                  "**/stanford_gamemaster/**",
                  "**/z_arc/**",
                  "**/__pycache__/**",
                  "**/*.pyc",
                  "**/*.pyo"
                ]
              },
              {
                "glob": "**/*.red",
                "input": "../../game_arena/clone_wars",
                "output": "py/game_arena/clone_wars"
              },
              {
                "glob": "**/examples/**/config.json",
                "input": "../../game_arena",
                "output": "py/game_arena",
                "ignore": [
                  "**/stanford_gamemaster/**",
                  "**/z_arc/**"
                ]
              },
              {
                "glob": "**/examples/**/2.python_code.py",
                "input": "../../game_arena",
                "output": "py/game_arena",
                "ignore": [
                  "**/stanford_gamemaster/**",
                  "**/z_arc/**",
                  "**/examples/*/deepseek_v3.2_speciale/**",
                  "**/examples/*/claude_sonnet_4/**",
                  "**/examples/*/gemini_2.5_flash/**",
                  "**/examples/*/gpt_5.2_pro/**",
                  "**/examples/*/gpt_5.4/**",
                  "**/examples/*/gpt_5.5_minimal/**",
                  "**/examples/*/claude_opus_4.5_max/**",
                  "**/examples/*/claude_opus_4.6_max/**",
                  "**/examples/*/claude_sonnet_4.5_max/**",
                  "**/examples/*/claude_opus_4.6_low/**",
                  "**/examples/*/claude_opus_4.6_medium/**",
                  "**/examples/*/glm_5.3/**"
                ]
              }
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "14kB",
                  "maximumError": "20kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "host": "0.0.0.0",
            "allowedHosts": true
          },
          "configurations": {
            "production": {
              "buildTarget": "arena_fe:build:production"
            },
            "development": {
              "buildTarget": "arena_fe:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
